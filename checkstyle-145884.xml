<?xml version="1.0"?>
<!-- 145884 - Lukasz Swiecicki -->
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Naming convention gate for CONSTANTS (static final fields), following the
  Google Java Style Guide (5.2.4) and the Oracle Java Naming Conventions:
  UPPER_SNAKE_CASE - uppercase letters and digits, words separated by a single
  underscore, starting with a letter, no leading/trailing/double underscores.
  Valid:   BOARD_SIZE, NUMBER_SHOTS, MAX_SHIPS, LOGGER
  Invalid: maxShips, Max_Ships, MAX__SHIPS, MAX_SHIPS_, _MAX
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <module name="TreeWalker">
    <module name="ConstantName">
      <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
      <property name="applyToPublic" value="true"/>
      <property name="applyToProtected" value="true"/>
      <property name="applyToPackage" value="true"/>
      <property name="applyToPrivate" value="true"/>
    </module>
  </module>
</module>
